      ]
    },
    {
      "name": "1. Lab Screenshots (Ordered 1 to 7)",
      "item": [
        {
          "name": "Screenshot 1 - GET All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.products && res.products.length > 0) {",
                  "  const study = res.products.find(p => p.name === 'Study Table');",
                  "  if (study) {",
                  "    pm.collectionVariables.set('studyTableId', study._id || study.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          },
          "response": []
        },
        {
          "name": "Screenshot 2 - POST Create Product (Gel Pen)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res._id || res.id) {",
                  "  pm.collectionVariables.set('productId', res._id || res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gel Pen Pack of 15\",\n  \"sku\": \"STNY-PN-713\",\n  \"category\": \"Stationery\",\n  \"price\": 120,\n  \"quantity\": 40,\n  \"reorderLevel\": 20,\n  \"supplier\": \"Cello Pens\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          },
          "response": []
        },
        {
          "name": "Screenshot 3 - PUT Update Product Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gel Pen Pack of 15\",\n  \"sku\": \"STNY-PN-713\",\n  \"category\": \"Stationery\",\n  \"price\": 140,\n  \"quantity\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Screenshot 4 - DELETE Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Screenshot 5 - GET Low-Stock Alert Report",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.lowStockItems && res.lowStockItems.length > 0) {",
                  "  const study = res.lowStockItems.find(p => p.name === 'Study Table') || res.lowStockItems[0];",
                  "  pm.collectionVariables.set('studyTableId', study._id || study.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/low-stock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "low-stock"]
            }
          },
          "response": []
        },
        {
          "name": "Screenshot 6 - GET Category Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "summary"]
            }
          },
          "response": []
        },
        {
          "name": "Screenshot 7 - PATCH Stock Adjustment (+10)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"change\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{studyTableId}}/stock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{studyTableId}}", "stock"]
            }
          },
          "response": []
        }
      ]
    },
