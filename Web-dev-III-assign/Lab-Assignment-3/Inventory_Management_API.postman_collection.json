  "item": [
    {
      "name": "0. System",
      "item": [
        {
          "name": "Root Welcome & Endpoints Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          },
          "response": []
